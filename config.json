    "CSV": {
        "csv_delimiter": ",",
        "csv_quotechar": "\"",
        "csv_columns": "File Path={filename}\nRepresentation={repre}\nFolder Path={ayon_folder_path}\nTask Name={ayon_task_name}\nVariant={variant}\nVersion={version}\nProduct Type={product_type}\nFrame Start={frame_start}\nFrame End={frame_end}\nHandle Start={head}\nHandle End={tail}\nVersion Thumbnail={prefs_thumb_path}\nSlate Exists={slate_exists}\nIntent=ingest\nVersion Comment={comment}\nFPS={fps}\nRepresentation Colorspace={repre_color}\nRepresentation Tags={repre_tags}"
    },
    "Conversions": {
        "run_thumb_after_scan": true,
        "run_review_after_scan": true,
        "skip_existing_thumbs": true,
        "skip_existing_reviews": true,
        "default_fps": 25.0,
        "use_fps_from_metadata": true,
        "seq_thumb_frame": "Middle",
        "thumb_size": 512,
        "thumb_location": "Relative to Source Folder",
        "thumb_location_path": "_thumbs",
        "thumb_suffix": "_thumbnail",
        "thumb_format": ".jpg",
        "thumb_quality": 80,
        "cmd_stills": "{ffmpeg} -i \"{filename}\" -vf \"scale=if(gte(iw\\,ih)\\,min({prefs_highres_thumb_size}\\,iw)\\,-4):if(lt(iw\\,ih)\\,min({prefs_highres_thumb_size}\\,ih)\\,-4)\" -y \"{prefs_thumb_path}\"",
        "cmd_videos": "{ffmpeg} -ss {metadata.thumbnail_time} -i \"{filename}\" -vframes 1 -vf \"scale=if(gte(iw\\,ih)\\,min({prefs_highres_thumb_size}\\,iw)\\,-4):if(lt(iw\\,ih)\\,min({prefs_highres_thumb_size}\\,ih)\\,-4)\" -y \"{prefs_thumb_path}\"",
        "cmd_sequences": "{ffmpeg} -i \"{metadata.seq_thumbnail_path}\" -vf \"scale=if(gte(iw\\,ih)\\,min({prefs_highres_thumb_size}\\,iw)\\,-4):if(lt(iw\\,ih)\\,min({prefs_highres_thumb_size}\\,ih)\\,-4)\" -y \"{prefs_thumb_path}\"",
        "timeout_seconds": 6,
        "pair_existing_media": true
    },
